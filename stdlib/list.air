## Module : list
## Utilitaires sur les listes de nombres (écrits en AirLang).
## Import : import list
## Les méthodes de base (`xs.map(...)`, `xs.sort()`, `xs.length()`...) n'ont pas besoin d'import.

## Liste des entiers de `from` (inclus) à `to` (exclu).
## Exemple : list.range(1, 4)  # => [1, 2, 3]
export fun range(from: Int, to: Int) -> List[Int]
    out: List[Int] = []
    i = from
    while i < to
        out.append(i)
        i += 1
    end
    return out
end

## Somme d'une liste d'entiers (0 si elle est vide).
## Exemple : list.sum([1, 2, 3])  # => 6
export fun sum(xs: List[Int]) -> Int
    total = 0
    for x in xs
        total += x
    end
    return total
end

## Somme d'une liste de flottants (0.0 si elle est vide).
## Exemple : list.sum_float([1.5, 2.5])  # => 4.0
export fun sum_float(xs: List[Float]) -> Float
    total = 0.0
    for x in xs
        total += x
    end
    return total
end

## Plus grand entier de la liste, ou null si elle est vide.
## Exemple : list.max_int([3, 9, 2])  # => 9
export fun max_int(xs: List[Int]) -> Int?
    if xs.length() == 0
        return null
    end
    best = xs[0]
    for x in xs
        if x > best
            best = x
        end
    end
    return best
end

## Plus petit entier de la liste, ou null si elle est vide.
## Exemple : list.min_int([3, 9, 2])  # => 2
export fun min_int(xs: List[Int]) -> Int?
    if xs.length() == 0
        return null
    end
    best = xs[0]
    for x in xs
        if x < best
            best = x
        end
    end
    return best
end

## Moyenne d'une liste de flottants, ou null si elle est vide.
## Exemple : list.average([1.0, 2.0, 6.0])  # => 3.0
export fun average(xs: List[Float]) -> Float?
    if xs.length() == 0
        return null
    end
    return sum_float(xs) / float(xs.length())
end
