## Module : string
## Utilitaires sur les chaînes de caractères (écrits en AirLang).
## Import : import string
## Les méthodes de base (`s.trim()`, `s.split(",")`, `s.slice(a, b)`...) n'ont pas besoin d'import.

## Vrai si la chaîne est vide.
## Exemple : string.is_empty("")  # => true
export fun is_empty(s: String) -> Bool
    return s.length() == 0
end

## Répète une chaîne `n` fois.
## Exemple : string.repeat("ab", 3)  # => "ababab"
export fun repeat(s: String, n: Int) -> String
    out = ""
    i = 0
    while i < n
        out = out + s
        i += 1
    end
    return out
end

## Complète à gauche avec `fill` (un caractère) jusqu'à `width` caractères.
## Exemple : string.pad_left("7", 3, "0")  # => "007"
export fun pad_left(s: String, width: Int, fill: String) -> String
    out = s
    while out.length() < width
        out = fill + out
    end
    return out
end

## Complète à droite avec `fill` (un caractère) jusqu'à `width` caractères.
## Exemple : string.pad_right("ab", 4, ".")  # => "ab.."
export fun pad_right(s: String, width: Int, fill: String) -> String
    out = s
    while out.length() < width
        out = out + fill
    end
    return out
end

## Inverse l'ordre des caractères.
## Exemple : string.reverse("abc")  # => "cba"
export fun reverse(s: String) -> String
    out = ""
    for ch in s
        out = ch + out
    end
    return out
end

## Met la première lettre en majuscule.
## Exemple : string.capitalize("air")  # => "Air"
export fun capitalize(s: String) -> String
    if s.length() == 0
        return s
    end
    return s.slice(0, 1).upper() + s.slice(1, s.length())
end

## Compte les occurrences non chevauchantes de `part` (qui ne doit pas être vide).
## Exemple : string.count("a,b,c", ",")  # => 2
export fun count(s: String, part: String) -> Int
    if part.length() == 0
        return 0
    end
    return s.split(part).length() - 1
end
